# Copy to .env and fill in. .env is gitignored; never commit real values.

# step0 — GitHub repo search
GITHUB_TOKEN=

# step2 — code generation (read by each provider's SDK)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# step4 — SonarQube
# Token: SonarQube > My Account > Security > Generate Token
SONAR_TOKEN=
SONAR_URL=http://localhost:9000
